model post {
  id         String     @id @default(uuid())
  title      String     @db.VarChar(250)
  content    String     @db.Text
  thumbnail  String?
  isFeatured Boolean
  status     PostStatus @default(PUBLISHED)
  tags       String[]
  views      Int        @default(0)
  authorId   String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  comments   comment[]

  @@index([authorId])
  @@map("tbl_posts")
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}
